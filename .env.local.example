# Get a free key at https://the-odds-api.com (500 free credits/month)
# Leave this blank/unset to run on sample matchup data.
ODDS_API_KEY=

# --- Supabase (powers the Picks database + /admin dashboard) ---
# Create a free project at https://supabase.com, then find these under
# Project Settings -> API Keys. Leave all three blank to run on sample
# picks data instead.

# Project Settings -> API Keys -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API Keys -> anon / public key
# Safe to expose in the browser — read-only, scoped by the table's RLS policy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API Keys -> service_role key
# SECRET — never expose this to the browser or commit it. Used only by
# app/admin/actions.ts (server-side) to add/edit/grade picks.
SUPABASE_SERVICE_ROLE_KEY=

# The password that unlocks /admin. Make this a real password, not a guess.
ADMIN_PASSWORD=
